// 漫游电台 design tokens — light (paper retro) and dark (dark wood) schemes.
forma roam-radio

theme
  paper = light-dark(#F4ECDF, #1B1410)
  ink = light-dark(#2A1D15, #EFE3CF)
  card = light-dark(#3A291E, #2B211A)
  toastDark = light-dark(#2A1D15, #17110C)
  tickInk = light-dark(#3A291E, #E9D6B4)
  dialFace = light-dark(#F3D99C, #4E3D29)
  dialEdge = light-dark(#7A5A3A, #C2A87F)
  creamText = #F7EBD6 scheme=fixed
  creamMut = #C9B396 scheme=fixed
  iconCream = #F4ECDF scheme=fixed
  amber = #F3D99C scheme=fixed
  brand = #FF5A36 scheme=fixed
  brandDeep = light-dark(#A8381A, #E86A45)
  brandInk = #2A1D15 scheme=fixed
  lampIdle = light-dark(#5A4535, #6E5A45)
  knob = light-dark(#E9D6B4, #6B563C)
  knobRing = light-dark(#2B1E15, #120D09)
  knobShadow = light-dark(#22170F, #0C0906)
  grille = light-dark(#4A3828, #3D2F22)
  grilleWell = light-dark(#2B1E15, #120D09)
  chipBg = light-dark(#EADFCD, #3B2E22)
  chipText = light-dark(#4A3828, #D8C6A8)
  panel = light-dark(#FBF6EE, #271E16)
  dash = light-dark(#CBB89E, #6E5C46)
  tabInactive = light-dark(#75634F, #A8917A)
  muted = light-dark(#6E5C4B, #A8917A)
  hairline = light-dark(rgba(58,41,30,.1), rgba(244,236,223,.1))
