// 漫游电台 Roam Radio — the engine. app.ts answers what it asks for.
// The view mirrors the interactive prototype (漫游电台 Roam Radio.html):
// a retro receiver with a tuner dial, one big shuffle button, three tabs
// (收音机 / 收藏 / 足迹), a region-and-genre sheet, a mini bar and toasts.

shape Station
  id: string
  name: string
  tagline: string
  stream: string
  fallback: string
  favicon: string
  country: string
  countryEn: string
  countryCode: string
  flag: string
  tags: string[]
  codec: string
  bitrate: number
  votes: number
  clicks: number
  frequency: number
  lat: number
  lon: number
  distanceKm: number

shape DialPick
  rev: number
  station: Station

shape CountryCount
  cc: string
  country: string
  count: number
  flag: string

shape FootRow
  station: Station
  freq: string
  place: string
  agoKind: string
  agoN: number

shape Footprint
  countryCount: number
  stationCount: number
  countries: CountryCount[]
  recent: FootRow[]

shape TimeChip
  part: string
  time: string

shape Prefs
  regions: string[]
  genre: string

shape Reply
  ok: bool
  favorited: bool

shape Time
  epochAtZero: number
  utcOffset: number
  resolvedLocale: string

routes nav
  tab radio "/"
  tab favorites "/favorites"
  tab history "/history"

keyframes pulse
  from opacity=0.45
  to opacity=1

fn saved(xs: Station[], id: string): bool =
  xs.filter(x => x.id == id).length > 0

fn pct(x: number): string =
  `${(x * 100).toFixed(2)}%`

fn posOf(f: number): number =
  (f - 87.5) / 20.5

fn tickLeft(i: number): string =
  pct(i / 41)

fn tickH(i: number): string =
  i % 4 == 0 ? "26px" : i % 2 == 0 ? "17px" : "10px"

fn tickOp(i: number): number =
  i % 4 == 0 ? 1 : 0.55

fn regionName(k: string): string =
  k == "asia" ? t("region-asia") : k == "europe" ? t("region-europe") : k == "africa" ? t("region-africa") : k == "americas" ? t("region-americas") : t("region-oceania")

fn genreName(k: string): string =
  k == "pop" ? t("genre-pop") : k == "jazz" ? t("genre-jazz") : k == "classical" ? t("genre-classical") : k == "rock" ? t("genre-rock") : k == "electronic" ? t("genre-electronic") : k == "news" ? t("genre-news") : k == "folk" ? t("genre-folk") : t("genre-all")

fn agoLabel(kind: string, n: number): string =
  kind == "now" ? t("ago-now") : kind == "min" ? t("ago-min", n = n.toFixed(0)) : kind == "hour" ? t("ago-hour", n = n.toFixed(0)) : kind == "day" ? t("ago-day", n = n.toFixed(0)) : ""

fn chipOn(on: bool): string =
  on ? "ink" : "transparent"

fn chipFg(on: bool): string =
  on ? "paper" : "ink"

component App
  state wantPlay = false
  state status = "idle"
  state errorCode = ""
  state current: option<Station> = none
  state dialRev = 0
  state tuning = false
  state jitterIdx = 0
  state needleFrom = 0.5
  state regions: string[] = []
  state draftRegions: string[] = []
  state genre = "all"
  state draftGenre = "all"
  state sheetOpen = false
  state toastText = ""
  state toastOn = false
  state restored = false
  state skips = 0
  state autoLeft = 0
  state triedFallback = false
  state regionKeys: string[] = ["asia", "europe", "africa", "americas", "oceania"]
  state genreKeys: string[] = ["all", "pop", "jazz", "classical", "rock", "electronic", "news", "folk"]
  state nowMs = 0

  resource time = exactTime() as shape Time else empty()

  derive epoch = time.epochAtZero + nowMs
  derive isZh = time.resolvedLocale.startsWith("zh")
  derive localeName = t("app-name")

  task tick mount
    every(60000, step)

  derive cur = top(nav)
  derive currentId = match current { case some(s) => s.id, case none => "" }
  derive hasCurrent = currentId != ""
  derive curName = match current { case some(s) => s.name, case none => "" }
  derive curTagline = match current { case some(s) => s.tagline, case none => "" }
  derive curFreq = match current { case some(s) => s.frequency, case none => 87.5 }
  derive curLon = match current { case some(s) => s.lon, case none => 0 }
  derive curCodec = match current { case some(s) => s.codec, case none => "" }
  derive curBitrate = match current { case some(s) => s.bitrate, case none => 0 }
  derive curTags = match current { case some(s) => s.tags.slice(0, 2), case none => [] }
  derive curStream = match current { case some(s) => (triedFallback and s.fallback != "" ? s.fallback : s.stream), case none => "" }
  derive playing = status == "playing"
  derive busy = tuning
  derive buffering = wantPlay and status == "loading" and not busy
  derive notPlaying = not playing
  derive isFav = saved(favs, currentId)
  derive lampOn = playing and not busy
  derive lampColor = lampOn ? "brand" : busy or buffering ? "amber" : "lampIdle"
  derive lampGlow = lampOn ? "0 0 10px #FF5A36" : "none"
  derive statusLabel = (busy
    ? t("status-tuning")
    : not hasCurrent
    ? t("status-standby")
    : status == "loading"
    ? t("status-buffering")
    : not wantPlay
    ? t("status-paused")
    : status == "failed"
    ? t("status-off-air")
    : t("status-on-air"))
  derive needleVal = busy ? sweepVal : posOf(curFreq)
  derive targetVal = (match first(picked) { case some(p) => p.rev == dialRev ? posOf(p.station.frequency) : needleFrom, case none => needleFrom })
  derive tp = jitterIdx >= 13 ? 1.0 : jitterIdx / 13.0
  derive sweepVal = needleFrom + (targetVal - needleFrom) * (1 + 2.70158 * (tp - 1) * (tp - 1) * (tp - 1) + 1.70158 * (tp - 1) * (tp - 1))
  derive needleLeft = pct(needleVal < 0 ? 0 : needleVal > 1 ? 1 : needleVal)
  derive freqLabel = (busy ? 87.5 + needleVal * 20.5 : curFreq).toFixed(1)
  derive titleText = busy ? t("status-tuning") : hasCurrent ? curName : t("status-empty-title")
  derive subText = busy ? t("sub-tuning") : hasCurrent ? curTagline : t("sub-empty")
  derive hintText = busy ? t("hint-busy") : hasCurrent ? t("hint-playing") : t("hint-empty")
  derive shuffleLabel = busy ? t("shuffle-busy") : t("shuffle")
  derive filterLabel = ((regions.length == 0 ? t("filter-world") : regions.map((r) => regionName(r)).join(t("sep")))
    + (genre == "all" ? "" : ` · ${genreName(genre)}`))
  derive pickedRev = match first(picked) { case some(p) => p.rev, case none => -1 }
  derive failedPlayer = status == "failed" and skips == 0
  derive errorHint = (errorCode == "network"
    ? t("error-network")
    : errorCode == "decode"
    ? t("error-decode")
    : errorCode == "src-not-supported"
    ? t("error-src")
    : errorCode == "not-allowed"
    ? t("error-blocked")
    : t("error-other"))

  resource favs = loadFavorites(isZh) as shape Station[] else empty()
  resource recent = loadRecent(isZh) as shape Station[] else empty()
  resource prefs = loadPrefs() as shape Prefs else empty()
  resource foot = footprint(isZh) with epoch as shape Footprint else empty()
  resource timeChip = localTime(curLon) with epoch when curLon != 0 as shape TimeChip else empty()
  resource picked = shuffleStation(dialRev, regions, genre, currentId, isZh) when dialRev > 0 as shape DialPick[] else empty()

  mutation savedList as shape Reply refreshes favs
  mutation logged as shape Reply refreshes recent, foot
  mutation savedPrefs as shape Reply refreshes prefs

  task jitter when tuning
    after(100, jitterTick)
  task landing when tuning and pickedRev == dialRev
    after(1400, lockIn)
  task gaveUp when tuning and dialRev > 0 and picked.length == 0 and not pending(picked)
    after(4000, stopTuning)
  task toastBye when toastOn
    after(2600, clearToast)
  task restore when not restored and recent.length > 0
    after(1, restoreLast)
  task skipOn when status == "failed" and skips > 0
    after(900, autoSkip)
  task adoptPrefs when prefs.regions.length > 0 or prefs.genre != ""
    after(1, applyPrefs)

  action noop

  action step
    nowMs = performanceNow()

  action selectTab(name: string)
    nav = select(nav, name)

  action follow(target: string)
    nav = go(nav, target)

  action showToast(msg: string)
    toastText = msg
    toastOn = true

  action clearToast
    toastOn = false
    toastText = ""

  action applyPrefs
    if prefs.regions.length > 0
      regions = prefs.regions
      draftRegions = prefs.regions
    if prefs.genre != ""
      genre = prefs.genre
      draftGenre = prefs.genre

  action tune
    if not busy
      tuning = true
      jitterIdx = 0
      needleFrom = posOf(curFreq)
      dialRev = dialRev + 1

  action jitterTick
    jitterIdx = jitterIdx + 1

  action lockIn
    match first(picked)
      case some(p)
        if p.rev == dialRev
          tuning = false
          play(p.station)
      case none
        tuning = false

  action stopTuning
    if tuning
      tuning = false
      showToast(t("toast-network"))

  action start(s: Station)
    current = some(s)
    wantPlay = true
    status = "loading"
    errorCode = ""
    triedFallback = false
    send logged = pushRecent(s, epoch)

  action play(s: Station)
    start(s)
    skips = 0
    autoLeft = 2

  action togglePlay
    if not busy
      if status == "failed"
        retry()
      else if not hasCurrent
        tune()
      else
        wantPlay = not wantPlay

  action started
    status = "playing"
    errorCode = ""
    skips = 0

  action pausedNow
    status = "paused"

  action failed(code: string)
    let fallbackReady = match current { case some(s) => (not triedFallback) and s.fallback != "", case none => false }
    status = "failed"
    errorCode = code
    if fallbackReady
      triedFallback = true
      status = "loading"
    else if autoLeft > 0
      skips = 1

  action autoSkip
    if status == "failed"
      skips = 0
      autoLeft = autoLeft - 1
      tune()

  action retry
    errorCode = ""
    status = "loading"
    wantPlay = true
    triedFallback = false

  action toggleFav
    if not hasCurrent
      showToast(t("toast-fav-need"))
    else
      match current
        case some(s)
          let had = saved(favs, s.id)
          send savedList = toggleFavorite(s)
          if had
            showToast(t("toast-unfav"))
          else
            showToast(t("toast-fav"))
        case none

  action removeFav(s: Station)
    send savedList = toggleFavorite(s)
    showToast(t("toast-unfav"))

  action openSheet
    draftRegions = regions
    draftGenre = genre
    sheetOpen = true

  action closeSheet
    sheetOpen = false
    // Dismissing the sheet (scrim tap) keeps the choices you made — the
    // chips must not snap back to the previous filter state. Say so: the
    // commit is silent otherwise, and the next shuffle changes underfoot.
    let changed = (regions.join(",") != draftRegions.join(",")) or (genre != draftGenre)
    regions = draftRegions
    genre = draftGenre
    send savedPrefs = savePrefs(draftRegions, draftGenre)
    if changed
      showToast(t("toast-sheet-applied"))

  action flipAllRegions
    draftRegions = []

  action flipRegion(k: string)
    draftRegions = draftRegions.includes(k) ? draftRegions.filter(x => x != k) : draftRegions.concat([k])

  action setGenre(k: string)
    draftGenre = k

  action applySheet
    sheetOpen = false
    let nextRegions = draftRegions
    let nextGenre = draftGenre
    regions = nextRegions
    genre = nextGenre
    send savedPrefs = savePrefs(nextRegions, nextGenre)
    tune()

  action restoreLast
    restored = true
    if not hasCurrent
      match first(recent)
        case some(s)
          current = some(s)
          wantPlay = false
          status = "idle"
        case none

  view
    main testId="app" viewport-fit="cover" width="100%" height="100%" max-width="560px" margin="0 auto"
      display="flex" flex-direction="column"
      navigationKey=`${cur.id}` navigate=follow

      if hasCurrent
        match current
          case some(s)
            audio src=curStream paused=(not wantPlay)
              metadata=MediaMetadata(title=s.name, artist=s.tagline, album=localeName, artwork=s.favicon)
              play=started playing=started pause=pausedNow ended=pausedNow
              error=failed
          case none
            view width=0 height=0

      view flex=1 min-height=0 position="relative" display="flex" testId="panels"
        for t in nav.tabs key=t.name
          view role="tabpanel" id=`panel-${t.name}` flex=1 min-height=0
            display=(nav.tab == t.name ? "flex" : "none")
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                display="flex" flex-direction="column" width="100%"

              if e.name == "radio"
                scroll flex=1 min-height=0
                  column gap=18 padding=`calc(6px + var(--exact-safe-area-inset-top)) 20px 28px`
                    row align-items="center" justify-content="space-between"
                      row align-items="center" gap=8
                        view width=12 height=12 border-radius=6 background-color="brand"
                        text localeName font-size="min(-exact-title3, 21px)" font-weight=700 testId="locale-title"
                      button -exact-press-scale=0.96 press=openSheet testId="open-filter" appearance="none" padding=0
                        row align-items="center" gap=6 height=36 padding="0 14px" border-radius=18
                          border="1.5px solid ink" background-color="transparent"
                          text filterLabel font-size="min(-exact-footnote, 13px)" font-weight=500 color="ink" testId="filter-label"
                          text "▼" font-size="min(-exact-caption2, 10px)"

                    column gap=16 padding=16 border-radius=28 background-color="card"
                      box-shadow="inset 0 1px 0 rgba(255,255,255,.08),0 12px 26px rgba(58,41,30,.25)"
                      testId="radio-face"
                      column height=94 border-radius=14 background-color="dialFace" position="relative"
                        box-shadow="inset 0 2px 10px rgba(58,41,30,.4)" overflow="hidden"
                        for i in range(42) key=i
                          view position="absolute" bottom=16 left=tickLeft(i) width=1.5 height=tickH(i)
                            background-color="tickInk" opacity=tickOp(i)
                        row position="absolute" bottom=8 left=0 right=0 justify-content="space-between" padding="0 0"
                          text "MHz" font-size="min(-exact-caption2, 11px)" color="dialEdge" padding="0 2px" testId="dial-mhz"
                          text "FM" font-size="min(-exact-caption2, 11px)" color="dialEdge" padding="0 2px" testId="dial-fm"
                        row gap=8 position="absolute" top=10 left=0 right=0 justify-content="space-between" padding="0 4px"
                          for f in [88, 92, 96, 100, 104, 108] key=f
                            text f.toFixed(0) font-size="min(-exact-caption2, 11px)" font-weight=500 color="tickInk" testId=`dial-${f}`
                        view position="absolute" top=4 bottom=4 left=needleLeft width=3 margin-left=-1.5 border-radius=2
                          background-color="brand" box-shadow="0 0 8px rgba(255,90,54,.6)" testId="needle"

                      column gap=6 padding="0 4px"
                        row align-items="center" justify-content="space-between" font-size="0.75rem" color="creamMut"
                          row align-items="center" gap=8
                            view width=8 height=8 border-radius=4 background-color=lampColor
                              box-shadow=lampGlow testId="lamp" animation=(busy or buffering ? "pulse 1s ease-in-out infinite" : "none")
                            text statusLabel font-size="min(-exact-caption1, 12px)" testId="status-label"
                          text `FM ${freqLabel}` font-size="min(-exact-caption1, 12px)" testId="freq-label"
                        text titleText font-size="min(-exact-title1, 26px)" font-weight=600 line-height=1.15 color="creamText"
                          line-clamp=2 min-height=60 testId="now-title"
                        text subText font-size="min(-exact-subheadline, 14px)" color="creamMut" line-clamp=1 testId="now-sub"

                      row align-items="center" gap=14
                        view flex=1 height=68 border-radius=12 background-color="knobRing" display="flex" flex-direction="column" align-items="stretch" justify-content="center" gap=9 padding="0 14px"
                          for g in range(5) key=g
                            view height=3 border-radius=2 background-color="grille"

                    row align-items="center" justify-content="space-between" padding="4px 14px 0"
                      button -exact-press-scale=0.96 press=toggleFav testId="fav-button" appearance="none" padding=0 background-color="transparent" aria-label=t("fav-aria") aria-pressed=isFav disabled=busy opacity=(busy ? 0.45 : 1)
                        view width=56 height=56 border-radius=28 display="flex" align-items="center" justify-content="center"
                          border="1.5px solid ink" background-color="transparent"
                          text (isFav ? "♥" : "♡") font-size="min(-exact-title2, 24px)" line-height=1.2 color=(isFav ? "brandDeep" : "ink")
                      button -exact-press-scale=0.96 press=tune testId="shuffle" appearance="none" padding=0 background-color="transparent" aria-label=t("shuffle-aria")
                        column width=118 height=118 border-radius=59 align-items="center" justify-content="center"
                          background-color="brand" box-shadow="0 7px 0 #C2401F,0 16px 26px rgba(58,41,30,.22)"
                          text shuffleLabel font-size="min(-exact-title3, 20px)" font-weight=700 color="brandInk"
                      button -exact-press-scale=0.96 press=togglePlay testId="play-toggle" appearance="none" padding=0 background-color="transparent" aria-label=t("play-pause-aria") disabled=busy opacity=(busy ? 0.45 : 1)
                        view width=56 height=56 border-radius=28 display="flex" align-items="center" justify-content="center"
                          background-color=(busy ? "card" : "toastDark")
                          if busy or buffering
                            image "symbol:circle" width=20 height=20 color="amber"
                              animation="pulse 1s ease-in-out infinite"
                          else if wantPlay
                            row gap=5
                              view width=5 height=18 border-radius=1.5 background-color="iconCream"
                              view width=5 height=18 border-radius=1.5 background-color="iconCream"
                          else
                            view width=17 height=20 margin-left=4 background-color="iconCream"
                              clip-path="polygon(0 0,100% 50%,0 100%)"

                    text hintText font-size="0.8125rem" color="muted" text-align="center" margin-top=2 testId="hint"

                    if hasCurrent and not busy
                      row flex-wrap="wrap" justify-content="center" gap=8 testId="chips"
                        for tg in curTags key=tg
                          view min-height=30 padding="0 12px" border-radius=15 display="flex" align-items="center" justify-content="center" background-color="chipBg"
                            text `#${tg}` font-size="min(-exact-caption1, 12.5px)" color="chipText"
                        if curLon != 0
                          view min-height=30 padding="0 12px" border-radius=15 display="flex" align-items="center" justify-content="center" background-color="chipBg"
                            text t("local-time", part = (timeChip.part == "dawn" ? t("part-dawn") : timeChip.part == "morning" ? t("part-morning") : timeChip.part == "noon" ? t("part-noon") : timeChip.part == "afternoon" ? t("part-afternoon") : t("part-evening")), time = timeChip.time) font-size="min(-exact-caption1, 12.5px)" color="chipText"

                    if failedPlayer
                      row align-items="center" gap=8 padding="0 8px" testId="player-error"
                        image "symbol:alert" width="1rem" height="1rem" color="brandDeep"
                        text errorHint font-size="0.8125rem" color="brandDeep" flex=1
                        button -exact-press-scale=0.96 press=retry testId="player-retry" t("retry")
                        button -exact-press-scale=0.96 press=tune testId="player-next" t("next")

              else if e.name == "favorites"
                scroll flex=1 min-height=0
                  column gap=16 padding=`calc(6px + var(--exact-safe-area-inset-top)) 20px 24px`
                    row align-items="flex-end" justify-content="space-between"
                      text t("tab-favorites") font-size="1.875rem" font-weight=700 testId="title-favorites"
                      text t("favs-count", n = favs.length.toFixed(0)) font-size="0.75rem" color="muted"
                    if favs.length == 0
                      column margin-top=40 padding="28px 24px" border-radius=22 align-items="center" gap=10
                        border="1.5px dashed dash" testId="favs-empty"
                        text "♡" font-size="2.125rem" color="brandDeep"
                        text t("favs-empty-title") font-size="1.0625rem" font-weight=600
                        text t("favs-empty-body")
                          font-size="0.875rem" color="muted" text-align="center" line-height=1.5
                        button -exact-press-scale=0.96 press=selectTab("radio") testId="empty-go-radio" appearance="none" padding=0
                          view min-height=44 padding="0 22px" border-radius=22 display="flex" align-items="center" justify-content="center"
                            background-color="ink"
                            text t("favs-go") font-size="0.875rem" font-weight=600 color="paper"
                    else
                      column gap=10 testId="feed-favorites"
                        for s in favs key=s.id
                          row -exact-press-scale=0.96 press=play(s) testId=`station-${s.id}` gap=14 align-items="center"
                            padding="12px 14px 12px 12px" border-radius=18 background-color="panel"
                            box-shadow="0 1px 0 rgba(58,41,30,.06)"
                            view min-width=56 min-height=56 flex=0 border-radius=16 display="flex" align-items="center" justify-content="center" background-color="card"
                              column gap=2 align-items="center" padding="4px 6px"
                                text s.flag font-size="1.375rem" line-height=1.25
                                text s.frequency.toFixed(1) font-size="min(-exact-footnote, 13px)" font-weight=500 color="amber"
                            column flex=1 min-width=0 gap=3
                              text s.name font-size="1rem" font-weight=600 line-clamp=1
                              text s.tagline font-size="0.8125rem" color="muted" line-clamp=1
                            if s.id == currentId
                              text t("status-on-air") font-size="min(-exact-caption2, 10px)" color="brandDeep"
                            button -exact-press-scale=0.96 press=removeFav(s) testId=`unfav-${s.id}` appearance="none" padding=0 aria-label=t("unfav-aria", n=s.name)
                              view width="2.75rem" height="2.75rem" flex=0 border-radius="1.375rem" display="flex" align-items="center" justify-content="center"
                                background-color="transparent"
                                text "♥" font-size="1.25rem" color="brandDeep"

              else if e.name == "history"
                scroll flex=1 min-height=0
                  column gap=20 padding=`calc(6px + var(--exact-safe-area-inset-top)) 20px 24px`
                    text t("tab-footprint") font-size="1.875rem" font-weight=700 testId="title-history"
                    column border-radius=24 background-color="card" padding="20px 22px" testId="foot-stats"
                      row gap=12
                        column flex=1 gap=2
                          text foot.countryCount.toFixed(0) font-size="3rem" font-weight=700 line-height=1.3 color="amber"
                          text t("foot-countries") font-size="0.875rem" color="creamMut"
                        column flex=1 gap=2
                          text foot.stationCount.toFixed(0) font-size="3rem" font-weight=700 line-height=1.3 color="creamText"
                          text t("foot-stations") font-size="0.875rem" color="creamMut"
                    if foot.stationCount == 0
                      text t("foot-empty")
                        font-size="0.875rem" color="muted" text-align="center" padding="16px 12px" testId="foot-empty"
                    else
                      column gap=10
                        text t("foot-places") font-size="0.6875rem" color="muted"
                        row flex-wrap="wrap" gap=8
                          for c in foot.countries key=c.cc
                            row min-height=34 padding="0 12px" border-radius=17 background-color="panel"
                              align-items="center" gap=6
                              text c.flag font-size="1.0625rem" line-height=1.3
                              text `×${c.count.toFixed(0)}` font-size="0.75rem" font-weight=500 color="muted"
                      column gap=10
                        text t("foot-recent") font-size="0.6875rem" color="muted"
                        for r in foot.recent.slice(0, 12) key=r.station.id
                          row -exact-press-scale=0.96 press=play(r.station) testId=`recent-${r.station.id}` gap=12 align-items="center"
                            padding="12px 16px" border-radius=18 background-color="panel"
                            column flex=1 min-width=0 gap=3
                              text r.station.name font-size="0.9375rem" font-weight=600 line-clamp=1
                              text r.place font-size="0.78125rem" color="muted" line-clamp=1
                            text agoLabel(r.agoKind, r.agoN) font-size="0.75rem" color="muted"

      row role="tablist" testId="tabs" flex=0 accent-color="brand"
        padding=`8px 18px max(26px, var(--exact-safe-area-inset-bottom))` border-top-color="hairline" border-top-style="solid" border-top-width="1px" background-color="paper"
        for t in nav.tabs key=t.name
          button role="tab" -exact-press-scale=0.96 press=selectTab(t.name) testId=`tab-${t.name}` aria-controls=`panel-${t.name}`
            aria-selected=(nav.tab == t.name) appearance="none" flex=1 min-height=0 padding=0
            display="flex" flex-direction="column" align-items="center" justify-content="center" gap=6
            image (t.name == "radio" ? "symbol:radio" : t.name == "favorites" ? "symbol:heart" : "symbol:pin")
              width="1.375rem" height="1.375rem" color=(nav.tab == t.name ? "brand" : "tabInactive")
            text t.name == "radio" ? t("tab-radio") : t.name == "favorites" ? t("tab-favorites") : t("tab-footprint")
              font-size="min(-exact-caption1, 12px)" font-weight=600 color=(nav.tab == t.name ? "ink" : "tabInactive")

      if toastOn
        row position="absolute" top=`calc(10px + var(--exact-safe-area-inset-top))` left=20 right=20 justify-content="center" testId="toast" aria-live="polite"
          view padding="11px 16px" border-radius=14 background-color="toastDark" max-width=320
            box-shadow="0 8px 20px rgba(42,29,21,.3)"
            text toastText font-size="min(-exact-footnote, 13.5px)" color="iconCream" text-align="center"

      if sheetOpen
        view position="absolute" inset=0 -exact-press-opacity=0.75 press=closeSheet testId="sheet-scrim"
          background-color=`light-dark(rgba(42,29,21,.42), rgba(0,0,0,.55))`
          view position="absolute" left=0 top=0 width="100%" height=60 -exact-press-opacity=0.75 press=closeSheet testId="sheet-scrim-top" appearance="none"
        column position="absolute" left=0 right=0 bottom=0 -exact-press-opacity=0.75 press=noop testId="filter-sheet"
          background-color="paper" border-top-left-radius=30 border-top-right-radius=30
          padding="12px 22px 34px" gap=20 box-shadow="0 -10px 30px rgba(42,29,21,.2)"
          view width=40 height=5 border-radius=3 background-color="dash" align-self="center"
          column gap=4
            text t("sheet-title") font-size="1.375rem" font-weight=700 testId="sheet-title"
            text t("sheet-sub") font-size="0.875rem" color="muted"
          column gap=10
            text t("sheet-regions") font-size="0.6875rem" color="muted"
            row flex-wrap="wrap" gap=8
              button -exact-press-scale=0.96 press=flipAllRegions testId="region-all" appearance="none" padding=0 aria-pressed=(draftRegions.length == 0)
                view min-height=40 padding="0 16px" border-radius=20 display="flex" align-items="center" justify-content="center"
                  border="1.5px solid ink" background-color=chipOn(draftRegions.length == 0)
                  text t("filter-world") font-size="min(-exact-subheadline, 14px)" font-weight=500 color=chipFg(draftRegions.length == 0)
              for k in regionKeys key=k
                button -exact-press-scale=0.96 press=flipRegion(k) testId=`region-${k}` appearance="none" padding=0 aria-pressed=draftRegions.includes(k)
                  view min-height=40 padding="0 16px" border-radius=20 display="flex" align-items="center" justify-content="center"
                    border="1.5px solid ink" background-color=chipOn(draftRegions.includes(k))
                    text regionName(k) font-size="min(-exact-subheadline, 14px)" font-weight=500 color=chipFg(draftRegions.includes(k))
          column gap=10
            text t("sheet-genre") font-size="0.6875rem" color="muted"
            row flex-wrap="wrap" gap=8
              for k in genreKeys key=k
                button -exact-press-scale=0.96 press=setGenre(k) testId=`genre-${k}` appearance="none" padding=0 aria-pressed=(draftGenre == k)
                  view min-height=40 padding="0 16px" border-radius=20 display="flex" align-items="center" justify-content="center"
                    border="1.5px solid ink" background-color=chipOn(draftGenre == k)
                    text genreName(k) font-size="min(-exact-subheadline, 14px)" font-weight=500 color=chipFg(draftGenre == k)
          button -exact-press-scale=0.96 press=applySheet testId="apply-sheet" appearance="none" padding=0
            view min-height=54 border-radius=27 display="flex" align-items="center" justify-content="center"
              background-color="brand" box-shadow="0 4px 0 #C2401F"
              text t("sheet-apply") font-size="min(-exact-callout, 16px)" font-weight=700 color="brandInk"
