// Airwave — the engine. app.ts answers what it asks for.

shape Country
  code: string
  name: string

shape Station
  id: string
  name: string
  tagline: string
  stream: string
  favicon: string
  country: string
  countryCode: string
  tags: string[]
  codec: string
  bitrate: number
  votes: number
  clicks: number
  frequency: number
  lat: number
  lon: number
  distanceKm: number

shape MapTile
  k: number
  url: string
  left: number
  top: number

shape MapView
  box: number
  half: number
  tiles: MapTile[]
  markerLeft: number
  markerTop: number
  hasMarker: bool
  pickLeft: number
  pickTop: number
  hasPick: bool
  lonPerPx: number
  latPerPx: number

shape DialPick
  rev: number
  station: Station

shape Lang
  code: string
  name: string

shape Reply
  ok: bool
  favorited: bool

routes nav
  tab home "/"
    tag "/tag/:tag"
    country "/country/:code"
    search "/search"
    nowHome "/now"
  tab radio "/radio"
    nowRadio "/radio/now"
  tab favorites "/favorites"
    nowFavorites "/favorites/now"

keyframes pulse
  from opacity=0.45
  to opacity=1

fn saved(xs: Station[], id: string): bool =
  xs.filter(x => x.id == id).length > 0

fn detailOf(s: Station): string =
  (s.country == "" ? s.codec : `${s.country} · ${s.codec}`) + (s.bitrate > 0 ? ` · ${s.bitrate} kbps` : "")

fn clamp(v: number, lo: number, hi: number): number =
  v < lo ? lo : v > hi ? hi : v

fn wrapLon(v: number): number =
  v > 180 ? v - 360 : v < -180 ? v + 360 : v

fn nearestLon(from: number, to: number): number =
  to - from > 180 ? to - 360 : to - from < -180 ? to + 360 : to

fn radiusFor(z: number): number =
  z <= 3 ? 1500 : z == 4 ? 800 : z == 5 ? 400 : z == 6 ? 200 : 100

component App
  state draft = ""
  state applied = ""
  state codecChoices: string[] = ["MP3", "AAC", "AAC+", "OGG"]
  state countries: Country[] = [Country(code="US", name="美国"), Country(code="GB", name="英国"), Country(code="DE", name="德国"), Country(code="FR", name="法国"), Country(code="JP", name="日本"), Country(code="CN", name="中国"), Country(code="BR", name="巴西"), Country(code="AU", name="澳大利亚")]
  state tags: string[] = ["jazz", "classical", "news", "rock", "pop", "electronic", "ambient", "hip hop", "talk", "oldies", "chillout", "world"]
  state volume = 1
  state wantPlay = false
  state status = "idle"
  state errorCode = ""
  state want = 40
  state current: option<Station> = none
  state dialRev = 0
  state tuning = false
  state booted = false
  state globeLat = 26
  state globeLon = 12
  state mapZoom = 3
  state dragging = false
  state dragX = 0
  state dragY = 0
  state dragLon = 12
  state dragLat = 26
  state settleRev = 0
  state pickLat = 0
  state pickLon = 0
  state areaRadius = 1500
  state areaMode = ""
  state restored = false
  state dragMoved = false
  state p1id = 0
  state p2id = 0
  state p1x = 0
  state p1y = 0
  state p2x = 0
  state p2y = 0
  state pinchSpan = 0
  state pinched = false
  state spinning = false
  state spinStep = 0
  state spinFromLat = 26
  state spinFromLon = 12
  state spinToLat = 26
  state spinToLon = 12
  state skips = 0
  state lang = ""
  state langName = ""
  state codec = ""

  derive cur = top(nav)
  derive inNow = cur.name == "nowHome" or cur.name == "nowRadio" or cur.name == "nowFavorites"
  derive tagValue = cur.name == "tag" ? cur.params.tag : ""
  derive countryValue = cur.name == "country" ? cur.params.code : ""
  derive currentId = match current { case some(s) => s.id, case none => "" }
  derive hasCurrent = currentId != ""
  derive curName = match current { case some(s) => s.name, case none => "" }
  derive curTagline = match current { case some(s) => s.tagline, case none => "" }
  derive curFavicon = match current { case some(s) => s.favicon, case none => "" }
  derive curDetail = match current { case some(s) => detailOf(s), case none => "" }
  derive playing = status == "playing"
  derive discoverMore = discoverList.length >= want
  derive tagMore = tagList.length >= want
  derive countryMore = countryList.length >= want
  derive foundMore = found.length >= want
  derive failedPlayer = status == "failed" and skips == 0
  derive curLat = match current { case some(s) => s.lat, case none => 0 }
  derive curLon = match current { case some(s) => s.lon, case none => 0 }
  derive tagLoading = pending(tagList) and tagList.length == 0
  derive countryLoading = pending(countryList) and countryList.length == 0
  derive tagBroken = failed(tagList) and tagList.length == 0
  derive countryBroken = failed(countryList) and countryList.length == 0
  derive busy = tuning or spinning
  derive areaOpen = areaMode != ""
  derive areaAsking = areaMode == "ask"
  derive areaBusy = areaOpen and settleRev > 0 and pending(nearby)
  derive areaEmpty = areaOpen and not pending(nearby) and nearby.length == 0
  derive askName = match first(nearby) { case some(s) => s.name, case none => "" }
  derive askFavicon = match first(nearby) { case some(s) => s.favicon, case none => "" }
  derive askKm = match first(nearby) { case some(s) => s.distanceKm, case none => 0 }
  derive areaKm = areaRadius >= 1000 ? `${round(areaRadius / 100) / 10} 千公里` : `${areaRadius} 公里`
  derive langLabel = lang == "" ? "语言" : langName
  derive lonStep = map.lonPerPx > 0 ? map.lonPerPx : 0.35
  derive latStep = map.latPerPx > 0 ? map.latPerPx : 0.35
  derive pickedRev = match first(picked) { case some(p) => p.rev, case none => -1 }

  resource discoverList = feed("discover", "", "", want, "", "") as shape Station[] else empty()
  resource tagList = feed("tag", tagValue, "", want, "", "") when tagValue != "" as shape Station[] else empty()
  resource countryList = feed("country", countryValue, "", want, "", "") when countryValue != "" as shape Station[] else empty()
  resource found = feed("search", "", applied, want, lang, codec) when applied != "" as shape Station[] else empty()
  resource langs = languages() as shape Lang[] else empty()
  resource favs = loadFavorites() as shape Station[] else empty()
  resource recent = loadRecent() as shape Station[] else empty()
  resource history = searchHistory() as shape string[] else empty()
  resource map = map(globeLat, globeLon, mapZoom, curLat, curLon, pickLat, pickLon) as shape MapView else empty()
  resource nearby = nearest(pickLat, pickLon, areaRadius) when settleRev > 0 as shape Station[] else empty()
  resource picked = randomStation(dialRev, currentId, pickLat, pickLon, areaRadius) when dialRev > 0 as shape DialPick[] else empty()

  mutation savedList as shape Reply refreshes favs
  mutation logged as shape Reply refreshes recent
  mutation recorded as shape Reply refreshes history

  task liveSearch when draft.trim() != applied
    after(450, commitDraft)
  task skipOn when status == "failed" and skips > 0
    after(900, autoSkip)
  task boot when not booted
    after(1, bootRadio)
  task restore when not restored and recent.length > 0
    after(1, restoreLast)
  task landing when tuning and pickedRev == dialRev
    after(650, lockIn)
  task gaveUp when tuning and dialRev > 0 and picked.length == 0 and not pending(picked)
    after(4000, stopTuning)
  task autoWiden when areaOpen and areaEmpty and areaRadius < 6000
    after(500, widenArea)
  task spinTick when spinning
    every(45, spinFrame)

  action pick(name: string)
    nav = select(nav, name)

  action follow(target: string)
    nav = go(nav, target)

  action type(value: string)
    draft = value

  action commitDraft
    commit(draft)

  action commit(value: string)
    let next = value.trim()
    draft = next
    applied = next
    want = 40
    if next != ""
      send recorded = pushSearch(next)

  action useSearch(q: string)
    draft = q
    applied = q
    want = 40
    nav = go(nav, "/search")
    send recorded = pushSearch(q)

  action goBack
    nav = back(nav)

  action noop
    draft = draft

  action selectTab(name: string)
    nav = select(nav, name)

  action goSearch
    nav = go(nav, "/search")

  action goTag(tag: string)
    want = 40
    nav = go(nav, path("tag", tag))

  action goCountry(code: string)
    want = 40
    nav = go(nav, path("country", code))

  action retryDiscover
    refresh discoverList

  action retryBrowse
    refresh tagList
    refresh countryList

  action loadMore
    if want < 400
      want = want + 40

  action setLang(code: string, name: string)
    lang = code
    langName = name
    want = 40

  action setCodec(name: string)
    codec = name
    want = 40

  action clearFilters
    lang = ""
    langName = ""
    codec = ""
    want = 40

  action play(s: Station)
    current = some(s)
    wantPlay = true
    status = "loading"
    errorCode = ""
    skips = 0
    areaMode = ""
    send logged = pushRecent(s)

  action recenterOnCurrent
    if hasCurrent
      spinTo(curLat, curLon)
    areaMode = ""

  action togglePlay
    if not busy
      if status == "failed"
        retry()
      else
        wantPlay = not wantPlay

  action started
    status = "playing"
    errorCode = ""
    skips = 0

  action pausedNow
    status = "paused"

  action loaded

  action failed(code: string)
    status = "failed"
    errorCode = code
    if skips < 2
      skips = skips + 1

  action autoSkip
    if status == "failed"
      skips = skips - 1
      nextStation()

  action retry
    errorCode = ""
    status = "loading"
    wantPlay = true

  action expand
    areaMode = ""
    nav = go(nav, nav.tab == "favorites" ? "/favorites/now" : nav.tab == "radio" ? "/radio/now" : "/now")

  action collapse
    nav = back(nav)

  action stopPlayback
    wantPlay = false
    status = "idle"
    nav = back(nav)

  action saveCurrent
    match current
      case some(s)
        send savedList = toggleFavorite(s)
      case none

  action tune
    if not busy
      tuning = true
      dialRev = dialRev + 1

  action lockIn
    match first(picked)
      case some(p)
        if p.rev == dialRev
          tuning = false
          play(p.station)
          if p.station.lat != 0 or p.station.lon != 0
            spinTo(p.station.lat, p.station.lon)
      case none
        tuning = false

  action stopTuning
    tuning = false

  action nextStation
    match current
      case some(s)
        play(s)
      case none
        if recent.length > 0
          match first(recent)
            case some(s)
              play(s)
            case none
        else
          tune()

  action setVolume(v: number)
    volume = v

  action bootRadio
    if cur.name == "home"
      nav = select(nav, "radio")
    booted = true

  action restoreLast
    restored = true
    if not hasCurrent and recent.length > 0
      match first(recent)
        case some(s)
          current = some(s)
          wantPlay = false
          status = "idle"
          globeLat = s.lat
          globeLon = s.lon
          pickLat = 0
          pickLon = 0
        case none

  action globeDown(e: PointerEvent)
    if p1id == 0
      p1id = e.pointerId
      p1x = e.offsetX
      p1y = e.offsetY
      dragging = true
      dragMoved = false
      dragX = e.offsetX
      dragY = e.offsetY
      dragLon = globeLon
      dragLat = globeLat
    else if p2id == 0
      p2id = e.pointerId
      p2x = e.offsetX
      p2y = e.offsetY
      let sx = p2x - p1x
      let sy = p2y - p1y
      pinchSpan = sx * sx + sy * sy
      pinched = true
      dragging = false

  action globeMove(e: PointerEvent)
    if p1id != 0 and e.pointerId == p1id
      p1x = e.offsetX
      p1y = e.offsetY
    if p2id != 0 and e.pointerId == p2id
      p2x = e.offsetX
      p2y = e.offsetY
    if p2id != 0 and pinchSpan > 0
      let sx = p2x - p1x
      let sy = p2y - p1y
      let span = sx * sx + sy * sy
      if span > pinchSpan * 1.8 and mapZoom < 8
        mapZoom = mapZoom + 1
        pinchSpan = span
      else if span * 1.8 < pinchSpan and mapZoom > 1
        mapZoom = mapZoom - 1
        pinchSpan = span
    else if dragging
      let dx = e.offsetX - dragX
      let dy = e.offsetY - dragY
      if dx > 24 or dx < -24 or dy > 24 or dy < -24
        dragMoved = true
      globeLon = wrapLon(dragLon - dx * lonStep)
      globeLat = clamp(dragLat + dy * latStep, -80, 80)

  action globeUp(e: PointerEvent)
    let wasP1 = p1id != 0 and e.pointerId == p1id
    let wasP2 = p2id != 0 and e.pointerId == p2id
    let last = (wasP1 and p2id == 0) or (wasP2 and p1id == 0)
    if wasP2
      p2id = 0
    if wasP1
      p1id = 0
    if last
      dragging = false
      if pinched
        pinched = false
        dragMoved = false
      else if dragMoved
        pickLat = globeLon
        pickLon = globeLon
        areaRadius = radiusFor(mapZoom)
        areaMode = "ask"
        settleRev = settleRev + 1
        dragMoved = false

  action closeArea
    areaMode = ""

  action widenArea
    if areaRadius < 6000
      areaRadius = areaRadius * 3
      settleRev = settleRev + 1

  action openAreaList
    areaMode = "list"

  action askPlayNearest
    match first(nearby)
      case some(s)
        playArea(s)
      case none
        areaMode = ""

  action playArea(s: Station)
    areaMode = ""
    pickLat = s.lat
    pickLon = s.lon
    play(s)
    if s.lat != 0 or s.lon != 0
      spinTo(s.lat, s.lon)

  action zoomIn
    if mapZoom < 8
      mapZoom = mapZoom + 1

  action zoomOut
    if mapZoom > 1
      mapZoom = mapZoom - 1

  action spinTo(lat: number, lon: number)
    spinFromLat = globeLat
    spinFromLon = globeLon
    spinToLat = lat
    spinToLon = nearestLon(globeLon, lon)
    spinStep = 0
    spinning = true

  action spinFrame
    spinStep = spinStep + 1
    let t = spinStep / 14
    let e = 1 - (1 - t) * (1 - t)
    globeLon = wrapLon(spinFromLon + (spinToLon - spinFromLon) * e)
    globeLat = spinFromLat + (spinToLat - spinFromLat) * e
    if spinStep >= 14
      spinning = false

  action onKey(k: string)
    if k == "Escape"
      if areaOpen
        areaMode = ""
      else if inNow
        nav = back(nav)

  view
    main testId="app" viewport-fit="cover" width="100%" height="100%" background-color="-exact-background"
      navigationKey=`${cur.id}` navigate=follow keycapture=onKey key=onKey

      if hasCurrent
        match current
          case some(s)
            audio src=s.stream paused=(not wantPlay) volume=volume
              metadata=MediaMetadata(title=s.name, artist=s.tagline, album="Airwave", artwork=s.favicon)
              play=started playing=started pause=pausedNow ended=pausedNow
              loadedmetadata=loaded error=failed
              nexttrack=nextStation
          case none
            view width=0 height=0

      for t in nav.tabs key=t.name
        view role="tabpanel" id=`panel-${t.name}` flex=1 min-height=0
          display=(nav.tab == t.name ? "flex" : "none")
          for e in t.stack key=e.id
            column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
              display="flex" flex-direction="column" width="100%"
              max-width=(e.name == "radio" ? "none" : "47.5rem") margin-left="auto" margin-right="auto"
              navigationPresentation=(e.name == "nowHome" or e.name == "nowRadio" or e.name == "nowFavorites" ? "modal" : "")
              navigationDetent=(e.name == "nowHome" or e.name == "nowRadio" or e.name == "nowFavorites" ? "large" : "")
              padding-bottom=(e.name == "radio" ? "0px" : hasCurrent and not inNow ? "calc(150px)" : "calc(86px)")

              if e.name == "home"
                if discoverList.length == 0 and failed(discoverList)
                  column flex=1 align-items="center" justify-content="center" gap=12 padding=24
                    image "symbol:alert" width=40 height=40 color="-exact-tertiary-label"
                    text "连不上电台索引" font="-exact-headline"
                    text "检查网络后重试。" font="-exact-footnote" color="-exact-secondary-label"
                    button press=retryDiscover testId="retry-discover" "重试"
                else
                  scroll flex=1 min-height=0 -exact-scroll-edge-effect="soft"
                    column gap=20 padding-bottom=24
                      row align-items="flex-end" gap=12 padding="8px 16px 0"
                        column flex=1 gap=2
                          text "发现" font="-exact-large-title" font-weight=700 testId="title-home"
                          text "五万个电台，随便挑一个" font="-exact-footnote" color="-exact-secondary-label"
                        button press=goSearch aria-label="搜索电台" testId="open-search" appearance="none" padding=0
                          column width=44 height=44 border-radius=22 align-items="center" justify-content="center"
                            background-color="-exact-secondary-background"
                            image "symbol:search" width=19 height=19 color="AccentColor"

                      if recent.length > 0
                        column gap=6
                          row padding="0 16px 4px"
                            text "继续收听" font="-exact-title3" font-weight=600
                          list display="flex" virtualized=true height=158 estimated-item-width=128 gap=12 padding="0 16px"
                            for s in recent key=s.id
                              button press=play(s) testId=`recent-${s.id}` appearance="none" padding=0
                                column width=116 gap=6 align-items="flex-start"
                                  view width=116 height=116 border-radius=14 position="relative" overflow="hidden"
                                    box-shadow="0 6px 16px rgba(10, 20, 35, 0.16)"
                                    background-color="-exact-secondary-background"
                                    image "symbol:radio" width=34 height=34 position="absolute" left=41 top=41
                                      color="-exact-secondary-label"
                                    if s.favicon != ""
                                      image s.favicon position="absolute" left=0 top=0 width=116 height=116
                                  text s.name font="-exact-caption1" line-clamp=2 line-height=1.25

                      column gap=6
                        row padding="0 16px 4px" align-items="center" gap=8
                          text "正在流行" font="-exact-title3" font-weight=600 flex=1
                        for s in discoverList.slice(0, 5) key=s.id
                          row press=play(s) testId=`station-${s.id}` gap=12 align-items="center" padding="7px 16px"
                            view width=52 height=52 border-radius=10 position="relative" overflow="hidden"
                              background-color="-exact-secondary-background"
                              image "symbol:radio" width=20 height=20 position="absolute" left=16 top=16
                                color="-exact-secondary-label"
                              if s.favicon != ""
                                image s.favicon position="absolute" left=0 top=0 width=52 height=52
                            column flex=1 min-width=0 gap=1
                              text s.name font="-exact-subheadline" line-clamp=1
                              text s.tagline font="-exact-caption2" color="-exact-secondary-label" line-clamp=1

                      column gap=6
                        row padding="0 16px 4px"
                          text "按类型" font="-exact-title3" font-weight=600
                        row flex-wrap="wrap" gap=8 padding="0 16px"
                          for tag in tags key=tag
                            button press=goTag(tag) testId=`tag-${tag}` appearance="none" padding=0
                              row padding="7px 13px" border-radius=16 background-color="-exact-secondary-background"
                                text tag font="-exact-subheadline"

                      column gap=6
                        row padding="0 16px 4px"
                          text "按国家" font="-exact-title3" font-weight=600
                        row flex-wrap="wrap" gap=8 padding="0 16px"
                          for c in countries key=c.code
                            button press=goCountry(c.code) testId=`country-${c.code}` appearance="none" padding=0
                              row padding="7px 13px" border-radius=16 background-color="-exact-secondary-background"
                                text c.name font="-exact-subheadline"
              else if e.name == "tag" or e.name == "country"
                header display="flex" align-items="center" gap=8 padding="8px 16px"
                  text (e.name == "tag" ? `#${e.params.tag}` : e.params.code) role="heading" aria-level=1 testId="title-browse"
                if (e.name == "tag" ? tagList : countryList).length == 0
                  if e.name == "tag" ? tagLoading : countryLoading
                    column flex=1 align-items="center" justify-content="center" gap=12
                      image "symbol:radio" width=30 height=30 color="-exact-secondary-label" animation="pulse 1.2s ease-in-out infinite"
                      text "正在载入电台…" font="-exact-subheadline" color="-exact-secondary-label"
                  else if e.name == "tag" ? tagBroken : countryBroken
                    column flex=1 align-items="center" justify-content="center" gap=12 padding=24
                      image "symbol:alert" width=40 height=40 color="-exact-tertiary-label"
                      text "连不上电台索引" font="-exact-headline"
                      button press=retryBrowse testId="retry-browse" "重试"
                  else
                    column flex=1 align-items="center" justify-content="center" gap=10 padding=24
                      image "symbol:radio" width=40 height=40 color="-exact-tertiary-label"
                      text "这里还没有登记的电台" font="-exact-headline"
                      text "换个类型或国家看看。" font="-exact-footnote" color="-exact-secondary-label"
                else
                  list testId=`feed-${e.name}` appearance="none" virtualized=true flex=1 min-height=0
                    estimated-item-height=64 reachend=loadMore reach-margin="60%"
                    for s in (e.name == "tag" ? tagList : countryList) key=s.id
                      row press=play(s) testId=`station-${s.id}` gap=12 align-items="center" padding="6px 16px" border-bottom="1px solid -exact-separator"
                        if s.favicon != ""
                          image s.favicon width=52 height=52 border-radius=12
                        else
                          view width=52 height=52 border-radius=12 background-color="-exact-tertiary-background" align-items="center" justify-content="center"
                            image "symbol:radio" width=22 height=22 color="-exact-secondary-label"
                        column flex=1 gap=2 min-width=0
                          text s.name font="-exact-subheadline" line-clamp=1
                          text s.tagline font="-exact-caption2" color="-exact-secondary-label" line-clamp=1
                        if s.id == currentId
                          image "symbol:waveform" width=18 height=18 color="AccentColor"

              else if e.name == "search"
                column gap=10 padding="8px 16px 10px"
                  header display="flex" align-items="center" gap=10
                    text "搜索" role="heading" aria-level=1 testId="title-search"
                    input testId="search-field" flex=1 value=draft input=type placeholder="电台名或类型"
                      padding="9px 12px" border-radius=12 background-color="-exact-secondary-background"
                  row gap=8
                    button press=noop testId="lang-filter" popovertarget="lang-menu" appearance="none" padding=0
                      row padding="6px 12px" border-radius=14 align-items="center" gap=4
                        background-color=(lang == "" ? "-exact-secondary-background" : "AccentColor")
                        text langLabel font="-exact-caption1" color=(lang == "" ? "-exact-label" : "#FFFFFF")
                        svg width=10 height=10 viewBox="0 0 24 24"
                          path d="M6 9l6 6 6-6" fill="none" stroke=(lang == "" ? "-exact-secondary-label" : "#FFFFFF") stroke-width=2.6 stroke-linecap="round" stroke-linejoin="round"
                    button press=noop testId="codec-filter" popovertarget="codec-menu" appearance="none" padding=0
                      row padding="6px 12px" border-radius=14 align-items="center" gap=4
                        background-color=(codec == "" ? "-exact-secondary-background" : "AccentColor")
                        text (codec == "" ? "编码" : codec) font="-exact-caption1" color=(codec == "" ? "-exact-label" : "#FFFFFF")
                        svg width=10 height=10 viewBox="0 0 24 24"
                          path d="M6 9l6 6 6-6" fill="none" stroke=(codec == "" ? "-exact-secondary-label" : "#FFFFFF") stroke-width=2.6 stroke-linecap="round" stroke-linejoin="round"
                    if lang != "" or codec != ""
                      button press=clearFilters testId="clear-filters" appearance="none" padding="6px 4px"
                        text "清除" font="-exact-caption1" color="AccentColor"
                  column id="lang-menu" popover="auto" role="menu" gap=2 padding=6
                    background-color="-exact-background" border-radius=14 box-shadow="0 12px 30px rgba(8,16,30,0.18)"
                    button role="menuitemradio" aria-checked=(lang == "") press=setLang("", "") testId="lang-all" appearance="none" padding="8px 10px"
                      row gap=8 align-items="center" width="100%"
                        text "全部语言" font="-exact-subheadline"
                        if lang == ""
                          image "symbol:checkmark" width=14 height=14 color="AccentColor"
                    for l in langs key=l.code
                      button role="menuitemradio" aria-checked=(lang == l.code) press=setLang(l.code, l.name) testId=`lang-${l.code}` appearance="none" padding="8px 10px"
                        row gap=8 align-items="center" width="100%"
                          text l.name font="-exact-subheadline"
                          if lang == l.code
                            image "symbol:checkmark" width=14 height=14 color="AccentColor"
                  column id="codec-menu" popover="auto" role="menu" gap=2 padding=6
                    background-color="-exact-background" border-radius=14 box-shadow="0 12px 30px rgba(8,16,30,0.18)"
                    button role="menuitemradio" aria-checked=(codec == "") press=setCodec("") testId="codec-all" appearance="none" padding="8px 10px"
                      row gap=8 align-items="center" width="100%"
                        text "全部编码" font="-exact-subheadline"
                        if codec == ""
                          image "symbol:checkmark" width=14 height=14 color="AccentColor"
                    for c in codecChoices key=c
                      button role="menuitemradio" aria-checked=(codec == c) press=setCodec(c) testId=`codec-${c}` appearance="none" padding="8px 10px"
                        row gap=8 align-items="center" width="100%"
                          text c font="-exact-subheadline"
                          if codec == c
                            image "symbol:checkmark" width=14 height=14 color="AccentColor"
                if applied == ""
                  column flex=1 min-height=0 gap=14 padding="4px 16px"
                    if history.length > 0
                      column gap=8
                        text "最近搜索" font="-exact-footnote" color="-exact-secondary-label"
                        row flex-wrap="wrap" gap=8
                          for q in history key=q
                            button press=useSearch(q) testId=`history-${q}` appearance="none" padding=0
                              row padding="6px 12px" border-radius=15 background-color="-exact-secondary-background"
                                text q font="-exact-footnote"
                    column gap=8
                      text "试试这些" font="-exact-footnote" color="-exact-secondary-label"
                      row flex-wrap="wrap" gap=8
                        for t in tags key=t
                          button press=goTag(t) testId=`suggest-${t}` appearance="none" padding=0
                            row padding="6px 12px" border-radius=15 background-color="-exact-secondary-background"
                              text t font="-exact-footnote"
                else if found.length == 0
                  if pending(found)
                    column flex=1 align-items="center" justify-content="center" gap=12
                      image "symbol:radio" width=30 height=30 color="-exact-secondary-label" animation="pulse 1.2s ease-in-out infinite"
                      text "正在搜索…" font="-exact-subheadline" color="-exact-secondary-label"
                  else
                    column flex=1 align-items="center" justify-content="center" padding=24 gap=14
                      image "symbol:search" width=44 height=44 color="-exact-tertiary-label"
                      text `没有找到「${applied}」` font="-exact-headline" text-align="center" line-clamp=2 testId="search-empty-title"
                      text "换个关键词，或者去发现的分类里翻翻。" font="-exact-footnote" color="-exact-secondary-label" text-align="center"
                      if lang != "" or codec != ""
                        button press=clearFilters testId="empty-clear-filters" appearance="none" padding=0
                          row padding="8px 16px" border-radius=16 background-color="-exact-secondary-background"
                            text (codec == "" ? `去掉「${langName}」筛选` : `去掉编码 ${codec} 筛选`)
                              font="-exact-subheadline" color="AccentColor"
                else
                  list testId="feed-search" appearance="none" virtualized=true flex=1 min-height=0
                    estimated-item-height=64 reachend=loadMore reach-margin="60%"
                    for s in found key=s.id
                      row press=play(s) testId=`station-${s.id}` gap=12 align-items="center" padding="6px 16px" border-bottom="1px solid -exact-separator"
                        if s.favicon != ""
                          image s.favicon width=52 height=52 border-radius=12
                        else
                          view width=52 height=52 border-radius=12 background-color="-exact-tertiary-background" align-items="center" justify-content="center"
                            image "symbol:radio" width=22 height=22 color="-exact-secondary-label"
                        column flex=1 gap=2 min-width=0
                          text s.name font="-exact-subheadline" line-clamp=1
                          text s.tagline font="-exact-caption2" color="-exact-secondary-label" line-clamp=1
                        if s.id == currentId
                          image "symbol:waveform" width=18 height=18 color="AccentColor"

              else if e.name == "favorites"
                header display="flex" align-items="center" gap=8 padding="8px 16px"
                  text "收藏" role="heading" aria-level=1 testId="title-favorites"
                  text `${favs.length} 个电台` font="-exact-footnote" color="-exact-secondary-label" flex=1
                if favs.length == 0
                  column flex=1 align-items="center" justify-content="center" gap=12 padding=24
                    image "symbol:star" width=44 height=44 color="-exact-tertiary-label"
                    text "还没有收藏" font="-exact-headline"
                    text "在播放面板里点星星，电台就会留在这里。" font="-exact-footnote" color="-exact-secondary-label" text-align="center"
                    button press=selectTab("home") testId="empty-go-home" "去发现"
                else
                  list testId="feed-favorites" flex=1 min-height=0
                    for s in favs key=s.id
                      row press=play(s) testId=`station-${s.id}` gap=12 align-items="center" padding="6px 16px" border-bottom="1px solid -exact-separator"
                        if s.favicon != ""
                          image s.favicon width=52 height=52 border-radius=12
                        else
                          view width=52 height=52 border-radius=12 background-color="-exact-tertiary-background" align-items="center" justify-content="center"
                            image "symbol:radio" width=22 height=22 color="-exact-secondary-label"
                        column flex=1 gap=2 min-width=0
                          text s.name font="-exact-subheadline" line-clamp=1
                          text s.tagline font="-exact-caption2" color="-exact-secondary-label" line-clamp=1

              else if e.name == "radio"
                column flex=1 min-height=0 position="relative" testId="radio-face"
                  margin-top="calc(-1 * var(--exact-safe-area-inset-top))"
                  view position="absolute" inset=0 testId="globe" background-color="#DDE6EE"
                    status-bar-style="dark-content" touch-action="none"
                    pointerdown=globeDown pointermove=globeMove pointerup=globeUp
                    view position="absolute" width=map.box height=map.box
                      left="50%" top="50%" margin-left=(0 - map.half) margin-top=(0 - map.half)
                      for t in map.tiles key=t.k
                        image t.url width=256 height=256 position="absolute" left=t.left top=t.top
                      if map.hasMarker
                        view position="absolute" left=(map.markerLeft - 11) top=(map.markerTop - 11)
                          width=22 height=22 border-radius=11 background-color="AccentColor"
                          border="3px solid #FFFFFF" box-shadow="0 2px 8px rgba(0, 0, 0, 0.35)"
                      if map.hasPick
                        view position="absolute" left=(map.pickLeft - 13) top=(map.pickTop - 13)
                          width=26 height=26 border-radius=13 press=openAreaList testId="pick-pin"
                          border="3px solid #FFFFFF" background-color="rgba(20, 60, 140, 0.20)"
                          box-shadow="0 2px 8px rgba(0, 0, 0, 0.35)"
                  if dragging
                    view position="absolute" left="50%" top="50%" width=28 height=28 border-radius=14
                      margin-left=-14 margin-top=-14 testId="map-center"
                      border="3px solid rgba(20, 60, 140, 0.55)" background-color="rgba(255, 255, 255, 0.70)"
                  column position="absolute" right=14 top="calc(14px + var(--exact-safe-area-inset-top))" gap=8
                    button press=zoomIn aria-label="放大" testId="zoom-in" appearance="none" padding=0
                      row width=44 height=44 border-radius=22 align-items="center" justify-content="center"
                        background-color="rgba(255, 255, 255, 0.88)" backdrop-filter="blur(18px)"
                        border="1px solid rgba(0, 0, 0, 0.06)"
                        image "symbol:add" width=18 height=18 color="-exact-label"
                    button press=zoomOut aria-label="缩小" testId="zoom-out" appearance="none" padding=0
                      row width=44 height=44 border-radius=22 align-items="center" justify-content="center"
                        background-color="rgba(255, 255, 255, 0.88)" backdrop-filter="blur(18px)"
                        border="1px solid rgba(0, 0, 0, 0.06)"
                        image "symbol:minus" width=18 height=18 color="-exact-label"
                  column position="absolute" left=14 bottom=170 gap=4 align-items="flex-start"
                    if not hasCurrent or busy
                      text (busy ? (tuning ? "正在换台…" : "正在移动…") : "拖动地图，松手看这一带有什么电台")
                        font="-exact-caption1" color="-exact-secondary-label" testId="radio-hint"
                        background-color="rgba(255, 255, 255, 0.82)" border-radius=8 padding="3px 8px"
                    text "地图 © Esri · HERE · Garmin · OpenStreetMap"
                      font="-exact-caption2" color="-exact-secondary-label" testId="map-credit"
                      background-color="rgba(255, 255, 255, 0.82)" border-radius=6 padding="2px 6px"
                  if areaOpen
                    column position="absolute" left=12 right=12 bottom=166 gap=0
                      max-width="36rem" margin-left="auto" margin-right="auto" box-sizing="border-box"
                      background-color="rgba(255, 255, 255, 0.95)" backdrop-filter="blur(26px)"
                      border-radius=18 box-shadow="0 14px 34px rgba(8, 16, 30, 0.20)" overflow="hidden"
                      row align-items="center" gap=8 padding="10px 14px"
                        column flex=1 gap=2 min-width=0
                          text "附近的电台" font="-exact-subheadline" font-weight=600 testId="area-header"
                          text (areaBusy ? `正在查看这一带（${areaKm}）…` : areaEmpty ? `这一带 ${areaKm}内没有登记的电台` : `${nearby.length} 个 · ${areaKm}内 · 按距离`)
                            font="-exact-caption2" color="-exact-secondary-label" line-clamp=1 testId="area-sub"
                        button press=closeArea aria-label="关闭" testId="area-close" appearance="none" padding=6
                          image "symbol:close" width=14 height=14 color="-exact-secondary-label"
                      if areaAsking
                        column gap=12 padding="0 14px 14px"
                          if areaBusy
                            row gap=10 align-items="center" animation="pulse 1.2s ease-in-out infinite"
                              view width=44 height=44 border-radius=10 background-color="-exact-tertiary-background"
                              column flex=1 gap=6
                                view height=12 width="70%" border-radius=6 background-color="-exact-tertiary-background"
                                view height=10 width="45%" border-radius=5 background-color="-exact-tertiary-background"
                          else if areaEmpty
                            column gap=10 align-items="center"
                              text "这一带没有登记的电台" font="-exact-subheadline" font-weight=600
                              text "换个大的范围，或者回到正在播的台。" font="-exact-caption2" color="-exact-secondary-label" text-align="center"
                              row gap=8
                                button press=widenArea testId="ask-widen" appearance="none" padding=0
                                  row height=40 padding="0 14px" border-radius=12 align-items="center" justify-content="center"
                                    background-color="-exact-tertiary-background"
                                    text "扩大范围" font="-exact-subheadline"
                                if hasCurrent
                                  button press=recenterOnCurrent testId="ask-recenter" appearance="none" padding=0
                                    row height=40 padding="0 14px" border-radius=12 align-items="center" justify-content="center"
                                      background-color="-exact-tertiary-background"
                                      text "回到当前电台" font="-exact-subheadline"
                          else
                            row gap=10 align-items="center"
                              if askFavicon != ""
                                image askFavicon width=44 height=44 border-radius=10
                              else
                                view width=44 height=44 border-radius=10 background-color="-exact-tertiary-background"
                                  align-items="center" justify-content="center"
                                  image "symbol:radio" width=20 height=20 color="-exact-secondary-label"
                              column flex=1 gap=2 min-width=0
                                text askName font="-exact-subheadline" line-clamp=1 testId="ask-name"
                                text `${askKm} 公里外最近的一台` font="-exact-caption2" color="-exact-secondary-label"
                            row gap=8 width="100%"
                              button press=askPlayNearest testId="ask-play" appearance="none" padding=0 flex=1
                                row height=40 padding="0 14px" border-radius=12 align-items="center" justify-content="center"
                                  background-color="AccentColor"
                                  text "开始播放" font="-exact-subheadline" font-weight=600 color="#FFFFFF"
                              button press=openAreaList testId="ask-list" appearance="none" padding=0
                                row height=40 padding="0 14px" border-radius=12 align-items="center" justify-content="center"
                                  background-color="-exact-tertiary-background"
                                  text "附近全部" font="-exact-subheadline"
                              button press=closeArea testId="ask-close" appearance="none" padding=0
                                row height=40 padding="0 14px" border-radius=12 align-items="center" justify-content="center"
                                  background-color="-exact-tertiary-background"
                                  text "取消" font="-exact-subheadline"
                      else
                        column gap=0
                          if areaBusy
                            column gap=10 padding="0 14px 14px" animation="pulse 1.2s ease-in-out infinite"
                              for i in [0, 1, 2] key=i
                                row gap=10 align-items="center"
                                  view width=40 height=40 border-radius=10 background-color="-exact-tertiary-background"
                                  column flex=1 gap=6
                                    view height=12 width="65%" border-radius=6 background-color="-exact-tertiary-background"
                                    view height=10 width="40%" border-radius=5 background-color="-exact-tertiary-background"
                          else if areaEmpty
                            column gap=10 padding="0 14px 14px" align-items="center"
                              text "这一带没有登记的电台" font="-exact-subheadline" font-weight=600
                              text "换个大的范围，或者回到正在播的台。" font="-exact-caption2" color="-exact-secondary-label" text-align="center"
                              row gap=8
                                button press=widenArea testId="area-widen" appearance="none" padding=0
                                  row height=40 padding="0 14px" border-radius=12 align-items="center" justify-content="center"
                                    background-color="-exact-tertiary-background"
                                    text "扩大范围" font="-exact-subheadline"
                                if hasCurrent
                                  button press=recenterOnCurrent testId="area-recenter" appearance="none" padding=0
                                    row height=40 padding="0 14px" border-radius=12 align-items="center" justify-content="center"
                                      background-color="-exact-tertiary-background"
                                      text "回到当前电台" font="-exact-subheadline"
                          else
                            list max-height="46%"
                              for s in nearby key=s.id
                                row press=playArea(s) testId=`area-station-${s.id}` gap=10 align-items="center"
                                  padding="8px 14px" border-bottom="1px solid -exact-separator"
                                  if s.favicon != ""
                                    image s.favicon width=40 height=40 border-radius=10
                                  else
                                    view width=40 height=40 border-radius=10 background-color="-exact-tertiary-background"
                                      align-items="center" justify-content="center"
                                      image "symbol:radio" width=18 height=18 color="-exact-secondary-label"
                                  column flex=1 gap=1 min-width=0
                                    text s.name font="-exact-subheadline" line-clamp=1
                                    text s.tagline font="-exact-caption2" color="-exact-secondary-label" line-clamp=1
                                  text (s.id == currentId ? "正在播放" : `${s.distanceKm} 公里`)
                                    font="-exact-caption2" color=(s.id == currentId ? "AccentColor" : "-exact-tertiary-label")

              else if e.name == "nowHome" or e.name == "nowRadio" or e.name == "nowFavorites"
                column flex=1 position="relative" testId="player-panel" gap=14
                  padding-left=20 padding-right=20 padding-bottom=20
                  padding-top="calc(12px + var(--exact-safe-area-inset-top))"
                  row align-items="center" gap=8
                    button press=collapse testId="player-collapse" aria-label="收起" appearance="none" padding="6px 4px"
                      row align-items="center" gap=4
                        svg width=14 height=14 viewBox="0 0 24 24"
                          path d="M6 9l6 6 6-6" fill="none" stroke=("AccentColor") stroke-width=2.6 stroke-linecap="round" stroke-linejoin="round"
                        text "收起" font="-exact-subheadline" color="AccentColor"
                    view flex=1
                    text "正在播放" font="-exact-subheadline" font-weight=600
                    view flex=1
                    button press=stopPlayback testId="player-stop" aria-label="关闭" appearance="none" padding=0
                      column width=40 height=40 border-radius=20 align-items="center" justify-content="center"
                        background-color="-exact-secondary-background"
                        image "symbol:close" width=15 height=15 color="-exact-secondary-label"
                  column flex=1 min-height=0 align-items="center" justify-content="center" gap=16
                    if curFavicon != ""
                      image curFavicon width=280 height=280 border-radius=20 box-shadow="0 18px 40px rgba(8, 16, 30, 0.22)"
                    else
                      view width=280 height=280 border-radius=20 background-color="-exact-tertiary-background"
                        align-items="center" justify-content="center" box-shadow="0 18px 40px rgba(8, 16, 30, 0.22)"
                        image "symbol:radio" width=64 height=64 color="-exact-secondary-label"
                    column gap=6 align-items="center"
                      text curName font="-exact-title2" font-weight=700 text-align="center" line-clamp=2 testId="panel-name"
                      text curTagline font="-exact-footnote" color="-exact-secondary-label" text-align="center" line-clamp=1
                      row gap=8 align-items="center"
                        if wantPlay
                          row padding="2px 7px" border-radius=6 background-color="#E5484D"
                            text "LIVE" font="-exact-caption2" font-weight=700 color="#FFFFFF"
                        text curDetail font="-exact-caption2" color="-exact-secondary-label"
                  if failedPlayer
                    row align-items="center" gap=8
                      image "symbol:alert" width=16 height=16 color="-exact-system-red"
                      text "这一台连不上" font="-exact-footnote" color="-exact-system-red" flex=1 testId="player-error"
                      button press=retry testId="player-retry" "重试"
                      button press=nextStation testId="player-next-2" "换一台"
                  row align-items="center" justify-content="center" gap=20 width="100%"
                    button press=saveCurrent testId="panel-save" aria-label="收藏" appearance="none" padding=0
                      view width=56 height=56 position="relative"
                        view position="absolute" inset=0 border-radius=28 background-color="-exact-secondary-background"
                        image (saved(favs, currentId) ? "symbol:star-fill" : "symbol:star") width=22 height=22
                          position="absolute" left=17 top=17 color="-exact-system-yellow"
                    button press=togglePlay testId="panel-toggle" aria-label="播放" appearance="none" padding=0
                      view width=56 height=56 position="relative"
                        view position="absolute" inset=0 border-radius=28
                          background-color=(busy ? "-exact-secondary-background" : "AccentColor")
                        image (busy ? "symbol:circle" : wantPlay ? "symbol:pause" : "symbol:play") width=24 height=24
                          position="absolute" left=16 top=16 color=(busy ? "-exact-secondary-label" : "#FFFFFF")
                    button press=tune testId="panel-next" aria-label="下一个电台" appearance="none" padding=0
                      column width=56 height=56 border-radius=28 align-items="center" justify-content="center"
                        background-color="-exact-secondary-background"
                        if busy
                          image "symbol:circle" width=22 height=22 color="AccentColor"
                            animation="pulse 1s ease-in-out infinite"
                        else
                          svg width=22 height=22 viewBox="0 0 24 24"
                            path d="M5 5l7 7-7 7" fill="none" stroke="AccentColor" stroke-width=2.4 stroke-linecap="round"
                            path d="M12 5l7 7-7 7" fill="none" stroke="AccentColor" stroke-width=2.4 stroke-linecap="round"
                  column gap=8
                    row align-items="center" gap=10
                      button press=setVolume(0) aria-label="静音" appearance="none" padding=2 testId="panel-mute"
                        image (volume > 0 ? "symbol:speaker" : "symbol:speaker-mute") width=16 height=16 color="-exact-secondary-label"
                      input type="range" value=volume input=setVolume min=0 max=1 step=0.05 flex=1 testId="panel-volume"

      if (hasCurrent or nav.tab == "radio") and not inNow
        row testId="player-bar" align-items="center" gap=10 padding="6px 10px" min-height=56
          position="absolute" left=12 right=12 bottom=90 border-radius=20 max-width="22rem"
          margin-left="auto" margin-right="auto" backgroundMaterial="regular"
          backdrop-filter="blur(24px) saturate(1.4)" box-shadow="0 10px 26px rgba(8, 16, 30, 0.16)"
          if hasCurrent
            row press=expand testId="player-open" align-items="center" gap=10 flex=1 min-width=0 aria-label="打开播放面板"
              if curFavicon != ""
                image curFavicon width=40 height=40 border-radius=10
              else
                view width=40 height=40 border-radius=10 background-color="-exact-tertiary-background"
                  align-items="center" justify-content="center"
                  image "symbol:radio" width=18 height=18 color="-exact-secondary-label"
              column flex=1 gap=1 min-width=0
                text curName font="-exact-subheadline" line-clamp=1 testId="player-name"
                text curTagline font="-exact-caption2" color="-exact-secondary-label" line-clamp=1
            if wantPlay
              row padding="2px 7px" border-radius=6 background-color="#E5484D"
                text "LIVE" font="-exact-caption2" font-weight=700 color="#FFFFFF"
            button press=togglePlay testId="player-toggle" aria-label=(wantPlay ? "暂停" : "播放") appearance="none" padding=0
              column width=44 height=44 border-radius=22 align-items="center" justify-content="center"
                if busy
                  image "symbol:circle" width=18 height=18 color="-exact-tertiary-label" animation="pulse 1s ease-in-out infinite"
                else if wantPlay
                  image "symbol:pause" width=18 height=18 color="AccentColor"
                else
                  image "symbol:play" width=18 height=18 color="AccentColor"
            button press=tune testId="player-next" aria-label="下一个电台" appearance="none" padding=0
              column width=44 height=44 border-radius=22 align-items="center" justify-content="center"
                if busy
                  image "symbol:circle" width=18 height=18 color="AccentColor" animation="pulse 1s ease-in-out infinite"
                else
                  svg width=20 height=20 viewBox="0 0 24 24"
                    path d="M5 5l7 7-7 7" fill="none" stroke="AccentColor" stroke-width=2.4 stroke-linecap="round"
                    path d="M12 5l7 7-7 7" fill="none" stroke="AccentColor" stroke-width=2.4 stroke-linecap="round"
          else
            row press=tune align-items="center" gap=10 flex=1 min-width=0
              view width=40 height=40 border-radius=10 background-color="-exact-tertiary-background"
                align-items="center" justify-content="center"
                image "symbol:radio" width=18 height=18 color="-exact-secondary-label"
              column flex=1 gap=1 min-width=0
                text "还没在播" font="-exact-subheadline" testId="player-idle"
                text "点右边的箭头，随机开一台" font="-exact-caption2" color="-exact-secondary-label"
              button press=tune testId="player-next" aria-label="随机开一台" appearance="none" padding=0
                column width=44 height=44 border-radius=22 align-items="center" justify-content="center"
                  if busy
                    image "symbol:circle" width=18 height=18 color="AccentColor" animation="pulse 1s ease-in-out infinite"
                  else
                    svg width=20 height=20 viewBox="0 0 24 24"
                      path d="M5 5l7 7-7 7" fill="none" stroke="AccentColor" stroke-width=2.4 stroke-linecap="round"
                      path d="M12 5l7 7-7 7" fill="none" stroke="AccentColor" stroke-width=2.4 stroke-linecap="round"

      row role="tablist" testId="tabs" appearance="none" position="absolute" left=12 right=12 bottom=24 height=56
        max-width="22rem" margin-left="auto" margin-right="auto" border-radius=28 align-items="stretch"
        justify-content="center" backgroundMaterial="glass" backdrop-filter="blur(24px) saturate(1.4)"
        box-shadow="0 10px 26px rgba(8, 16, 30, 0.16)"
        button role="tab" press=selectTab("home") testId="tab-home" aria-controls="panel-home"
          aria-selected=(nav.tab == "home") appearance="none" flex=1 min-height=0 padding=0
          display="flex" flex-direction="column" align-items="center" justify-content="center" gap=2 max-width="12rem"
