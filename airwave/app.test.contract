// 漫游电台's authored checks. Run with:
//   bun exact.mjs test web
// The station index is a live network service, so these tests assert what the app
// owns: the tabs, the dial, the filter sheet, favorites, and the states before any
// answer comes back.
locale "zh-CN"

test "the app opens on the radio tab in standby"
  clock settle
  expect state nav.tab == "radio"
  expect text "status-label" == "待机"
  expect text "now-title" == "世界在等你"
  expect text "now-sub" == "点下面的大按钮，随便去个地方"
  expect text "freq-label" == "FM 87.5"

test "the default filter label is the whole world"
  clock settle
  tap "open-filter"
  expect text "sheet-title" == "想去哪儿听？"
  expect state draftRegions.length == 0
  expect state draftGenre == "all"
  tap "apply-sheet"
  clock settle
  expect state sheetOpen == false

test "picking regions and a genre updates the draft, not the live filter"
  tap "open-filter"
  tap "region-asia"
  tap "region-europe"
  expect state draftRegions.length == 2
  expect state regions.length == 0
  tap "genre-jazz"
  expect state draftGenre == "jazz"
  tap "region-all"
  expect state draftRegions.length == 0

test "applying the sheet saves prefs and starts tuning"
  tap "open-filter"
  tap "region-asia"
  tap "genre-jazz"
  tap "apply-sheet"
  clock settle
  expect state sheetOpen == false
  expect state regions.length == 1
  expect state genre == "jazz"
  expect state tuning == true
  expect state dialRev == 1

test "tuning jitters the needle then lands"
  tap "shuffle"
  expect state tuning == true
  expect state dialRev == 1
  expect text "status-label" == "调频中…"
  expect text "now-title" == "调频中…"
  clock +1400
  clock settle
  expect state tuning == false
  // The unreachable directory answer is an actionable toast; let it lapse so
  // the screen this test ends on is clean.
  clock +8000
  clock settle
  expect state toastOn == false

test "the filter label reflects a chosen genre"
  clock settle
  tap "open-filter"
  tap "genre-pop"
  tap "apply-sheet"
  clock +1400
  clock settle
  tap "open-filter"
  expect text "filter-label" == "全世界 · 流行"
  tap "apply-sheet"
  clock settle

test "the radio face keeps the dial between the band ends"
  clock settle
  expect state curFreq >= 87.5
  expect state curFreq <= 107.5

test "favorites starts empty with its dashed prompt"
  tap "tab-favorites"
  clock data
  expect state favs == []
  expect text "title-favorites" == "收藏"
  expect text "favs-empty" == "♡还没有收藏遇到喜欢的台，点一下收音机旁的爱心，它就会住进这里。去随便听听"

test "the favorites empty state goes back to the radio"
  tap "tab-favorites"
  tap "empty-go-radio"
  expect state nav.tab == "radio"

test "the footprint tab reports zeros on a fresh app"
  tap "tab-history"
  clock data
  expect text "title-history" == "足迹"
  expect state foot.countryCount == 0
  expect state foot.stationCount == 0
  expect text "foot-empty" == "还没有足迹。随机听过的每台电台都会记在这里。"

test "the tab bar carries the three screens"
  clock settle
  expect text "tab-radio" == "收音机"
  expect text "tab-favorites" == "收藏"
  expect text "tab-history" == "足迹"

test "favorites toast when saved"
  clock settle
  tap "fav-button"
  clock data
  expect state toastOn == true
  clock +2600
  expect state toastOn == false

test "dismissing the sheet keeps the chosen filters"
  clock settle
  clock data
  tap "open-filter"
  clock settle
  tap "region-asia"
  tap "genre-jazz"
  tap "sheet-scrim-top"
  clock settle
  clock data
  expect state sheetOpen == false
  expect state regions.length == 1
  expect state genre == "jazz"
  clock +2600
  tap "open-filter"
  clock settle
  clock data
  expect state draftRegions.length == 1
  expect state draftGenre == "jazz"

// cleanName truncates by rendered width, not characters: the station index is
// pinned with `answer fetch` so the shuffle lands on a known name.
test "a long CJK station name truncates to the dial's width"
  answer fetch "https://de1.api.radio-browser.info" with 200 [{"stationuuid":"cjk-width-1","name":"早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早早 || Jazz,Piano","url_resolved":"https://example.org/cjk","url":"https://example.org/cjk","hls":0,"countrycode":"JP","country":"Japan","codec":"MP3","bitrate":128,"votes":1,"clickcount":1,"tags":"jazz"}]
  clock settle
  tap "shuffle"
  clock +1400
  clock settle
  expect state tuning == false
  expect text "now-title" == "早早早早早早早早早早早早早早早早早早早早早早早…"
  // The pinned name is a worst-case-width fixture; end off the radio face so
  // the resting screen is not the oversized string.
  tap "tab-favorites"
  clock data

test "a long ASCII station name also cuts at the width budget"
  answer fetch "https://de1.api.radio-browser.info" with 200 [{"stationuuid":"ascii-width-1","name":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","url_resolved":"https://example.org/ascii","url":"https://example.org/ascii","hls":0,"countrycode":"US","country":"United States","codec":"MP3","bitrate":128,"votes":1,"clickcount":1,"tags":"rock"}]
  clock settle
  tap "shuffle"
  clock +1400
  clock settle
  expect state tuning == false
  expect text "now-title" == "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA…"
  tap "tab-favorites"
  clock data

// A sweep that cannot reach the directory must offer a retry, not hang on
// 「调频中」 or claim the world ran out of stations.
test "an unreachable directory offers a tap-to-retry toast"
  fail fetch "https://de1.api.radio-browser.info"
  fail fetch "https://all.api.radio-browser.info"
  clock settle
  tap "shuffle"
  clock +1400
  clock settle
  expect state tuning == false
  expect state toastAct == "retune"
  expect text "toast" == "连不上电台目录，稍后再试点一下重试"
  tap "toast-act"
  expect state tuning == true
  expect state dialRev == 2
  clock +1400
  clock settle
  expect state toastAct == "retune"
  clock +8000
  clock settle
  expect state toastOn == false

test "an empty answer says so instead of shrugging"
  answer fetch "https://de1.api.radio-browser.info" with 200 []
  clock settle
  tap "shuffle"
  clock +1400
  clock settle
  expect state tuning == false
  expect state hasCurrent == false
  expect state toastAct == ""
  expect text "toast" == "这个筛选下暂时没有台在播"
  clock +2600
  clock settle

test "cancel drops the sheet's draft without committing it"
  clock settle
  tap "open-filter"
  clock settle
  expect focused "region-all"
  tap "region-asia"
  tap "genre-jazz"
  tap "sheet-cancel"
  clock settle
  expect state sheetOpen == false
  expect state regions.length == 0
  expect state genre == "all"
  expect focused "open-filter"
  tap "open-filter"
  clock settle
  expect state draftRegions.length == 0
  expect state draftGenre == "all"
  tap "sheet-cancel"
  clock settle

test "Escape closes the sheet without committing" on web
  clock settle
  tap "open-filter"
  clock settle
  tap "region-europe"
  type "app" key "Escape"
  clock settle
  expect state sheetOpen == false
  expect state regions.length == 0
  expect focused "open-filter"

test "Tab cycles the sheet's controls" on web
  clock settle
  tap "open-filter"
  clock settle
  type "app" key "Tab"
  clock settle
  expect focused "region-asia"
  type "app" key "Tab"
  clock settle
  expect focused "region-europe"
  tap "sheet-cancel"
  clock settle

test "the system media controls skip to the next station" on web
  answer fetch "https://de1.api.radio-browser.info" with 200 [{"stationuuid":"ms-1","name":"One","url_resolved":"https://example.org/a","url":"https://example.org/a","hls":0,"countrycode":"JP","country":"Japan","codec":"MP3","bitrate":128,"votes":1,"clickcount":1,"tags":"jazz"}]
  clock settle
  tap "shuffle"
  clock +1400
  clock settle
  expect state hasCurrent == true
  expect mediasession owner == "player"
  expect mediasession has "nexttrack"
  tap "player" mediasession "nexttrack"
  expect state tuning == true
  expect state dialRev == 2
  clock settle
  clock +8000
  clock settle
  tap "tab-favorites"
  clock data

test "the space bar toggles without a focused button" on web
  clock settle
  type "app" key " "
  expect state tuning == true
  clock settle
  type "app" key " "
  expect state dialRev == 2
  clock settle
  clock +8000
  clock settle
  expect state toastOn == false
