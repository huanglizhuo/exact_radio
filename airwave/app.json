{
  "$schema": "../.extern/exact/scripts/app.schema.json",
  "name": "Airwave",
  "short_name": "Airwave",
  "id": "com.lizhuo.airwave",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#111113",
  "audio_session": "playback",
  "app": {
    "id": "com.lizhuo.airwave",
    "name": "Airwave"
  },
  "host": {
    "web": {
      "head": [
        {
          "meta": {
            "name": "apple-mobile-web-app-capable",
            "content": "yes"
          }
        },
        {
          "meta": {
            "name": "apple-mobile-web-app-status-bar-style",
            "content": "default"
          }
        },
        {
          "meta": {
            "name": "apple-mobile-web-app-title",
            "content": "Airwave"
          }
        }
      ]
    },
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ],
      "backgroundModes": [
        "audio"
      ]
    },
    "macos": {
      "window": {
        "width": 1100,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "keepRunning": true
      },
      "minimumOS": "14.0"
    },
    "android": {}
  },
  "deploy": {
    "store": {
      "web": "0",
      "ios": "A",
      "macos": "A",
      "android": "A"
    },
    "channels": {
      "prod": "https://airwave-76y.pages.dev/updates"
    },
    "signing": {
      "key": "airwave",
      "keys": {
        "airwave": "vX8OMyk0qKwgjqwWIRaY0ZoJ73QCGXgo8R6eiuYUFj8="
      }
    }
  },
  "icons": [
    {
      "src": "assets/icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "userInterfaceStyle": "light",
  "packages": {
    "@exact/maps": {
      "web": {
        "tiles": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": "© OpenStreetMap contributors",
        "maxZoom": 19
      },
      "android": {
        "apiKey": { "env": "EXACT_GOOGLE_MAPS_API_KEY" }
      }
    }
  }
}